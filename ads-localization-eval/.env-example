# Copy to .env and fill in.

# Anthropic API key (used by the taste judge and, if your copy agent runs on
# Managed Agents, by the translate step too).
ANTHROPIC_API_KEY=sk-ant-...

# Your copy translation agent on Claude Managed Agents.
# translate-ads.ts opens a session against this agent to produce the Greek copy.
COPY_AGENT_ID=agent_...
COPY_AGENT_ENV_ID=env_...
